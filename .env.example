# MongoDB connection string for the least-privilege "antitheft_webapp" user (find-only).
MONGODB_URI=mongodb+srv://antitheft_webapp:<password>@<cluster-host>/?authSource=admin&appName=tracker

# Database and collection holding the location points.
MONGODB_DB=n8n
MONGODB_COLLECTION=antitheft_locations
MONGODB_ROUTES_VIEW=antitheft_routes

# Password checked against the login form (SHA-256 + timing-safe compare).
TRACKER_PASSWORD=change-me

# HMAC secret for signing session cookies. Must be at least 32 characters.
SESSION_SECRET=change-me-to-a-random-32-plus-character-string

# For real Atlas access during local dev, run `npm run dev:atlas` and put the real
# MONGODB_URI in .env.atlas.local (gitignored) — it overrides .env.local for that mode only.
